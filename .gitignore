# 依存パッケージ(npm install で復元できるのでGitには入れない)
node_modules/

# ビルド結果(コードから作り直せるのでGitには入れない)
dist/
build/
standalone/

# 環境変数(APIキーなどの秘密情報。絶対にGitに入れない)
.env
.env.local
.env.*.local

# エディタ・OSが作るファイル
.DS_Store
.vscode/
.idea/
*.log
npm-debug.log*

# 一時ファイル(Artifact公開用に生成したもの)
.artifact.html
.artifact-mictest.html

# 帯の検証(`npm run test:bar`)が一時的に作るもの
__bar.html
__shell.html
vite.bar.config.js

# `npm run test:bar` が骨組みを描くために一時的に作る(中の道が /tmp なので、残しても次は使えない)
vite.shell.config.js
