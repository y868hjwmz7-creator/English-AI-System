{
  "name": "english-ai-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "英語学習の記録・発音練習アプリと、指導者向け管理ダッシュボード",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "BASE_PATH=/English-AI-System/ vite build",
    "build:single": "BUILD_SINGLE=1 vite build",
    "preview": "vite preview",
    "audio": "node scripts/generate-audio.mjs",
    "test:db": "bash scripts/test-migration.sh",
    "lint": "eslint .",
    "test:chunk": "node scripts/test-chunker.mjs",
    "test:audio": "node scripts/test-loudness.mjs",
    "test:mp3": "node scripts/check-mp3-join.mjs",
    "test:play": "node scripts/test-playmark.mjs",
    "test:gap": "node scripts/test-turngap.mjs",
    "test:paper": "node scripts/check-paper-vars.mjs",
    "test:bar": "node scripts/test-bar.mjs",
    "test:voice": "node scripts/check-voice-cast.mjs",
    "test:frame": "node scripts/test-frame.mjs",
    "test:shift": "node scripts/test-shift.mjs",
    "test:speak": "node scripts/test-speak.mjs",
    "slides": "node scripts/make-frames-slides.mjs",
    "test:similar": "node scripts/test-similar.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
